# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Service role bypasses RLS. It is used ONLY for background jobs that have no
# user context (nightly exports, webhook handlers). Request handling uses the
# caller's own token so RLS applies -- see docs/SECURITY.md.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Stripe Connect
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ---------------------------------------------------------------------------
# Redis (Upstash) -- rate limiting and cross-instance pub/sub
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
SENTRY_DSN=
